ML_SERVICE_TOKEN=dev-token
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_URL=https://api.elevenlabs.io/v1/speech-to-text

# K2 cleanup — OpenAI-compatible chat/completions (default: K2 Think v2 at api.k2think.ai)
K2THINK_API_KEY=
# Optional aliases: K2_API_KEY, or MOONSHOT_API_KEY if you only use Moonshot Kimi
K2_BASE_URL=https://api.k2think.ai/v1
K2_CLEANUP_MODEL=MBZUAI-IFM/K2-Think-v2
K2_MODEL=MBZUAI-IFM/K2-Think-v2
# Moonshot Kimi alternative: K2_BASE_URL=https://api.moonshot.ai/v1 and K2_CLEANUP_MODEL=kimi-k2-thinking
K2_TIMEOUT_SECONDS=120
K2_TEMPERATURE=0.3
# Set to 1 only if your endpoint supports OpenAI-style JSON mode
K2_JSON_MODE=0

WHISPER_PROVIDER=replicate
WHISPER_MODEL=large-v3
WHISPER_REPLICATE_MODEL=openai/whisper-large-v3
WHISPER_MODAL_ENDPOINT=
GEMINI_MODEL=gemini-2.5-pro
IMAGE_PRIMARY=imagen-3
IMAGE_FALLBACK=flux.1-schnell
GEMINI_AUDIO_MODEL=gemini-2.5-flash-preview-native-audio-dialog

# Google AI / Veo3
GOOGLE_GENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VEO3_MODEL=veo-3.0-generate-preview
VEO3_TIMEOUT_SECONDS=900
VEO3_POLL_SECONDS=5

# Keys: service checks GOOGLE_TTS_API_KEY first, then GOOGLE_API_KEY, then GEMINI_API_KEY
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=

REPLICATE_API_TOKEN=
FAL_KEY=
